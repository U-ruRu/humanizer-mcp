HUMANIZER_MCP_HOST=127.0.0.1
HUMANIZER_MCP_PORT=8090
HUMANIZER_MCP_PUBLIC_BASE_URL=https://humanizer.example.com
HUMANIZER_MCP_HUMANIZER_ROOT=/opt/humanizer-ru
HUMANIZER_MCP_DATABASE_PATH=/var/lib/humanizer-mcp/humanizer-mcp.sqlite3
HUMANIZER_MCP_AUTH_MODE=oauth
HUMANIZER_MCP_OAUTH_REQUIRED_SCOPES=humanizer:use
HUMANIZER_MCP_OAUTH_SIGNING_SECRET=change-me
# HUMANIZER_MCP_OAUTH_SIGNING_SECRET_FILE=/etc/humanizer-mcp/oauth-signing-secret
HUMANIZER_MCP_OAUTH_ADMIN_USERNAME=admin
HUMANIZER_MCP_OAUTH_ADMIN_PASSWORD=change-me
# HUMANIZER_MCP_OAUTH_ADMIN_PASSWORD_FILE=/etc/humanizer-mcp/oauth-admin-password
